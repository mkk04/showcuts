# Local development configuration.
# Copy this file to ".env" (which is git-ignored) and adjust as needed.

# Show detailed error pages and disable HTTPS-only hardening locally.
DJANGO_DEBUG=True

# Any non-empty string works for local development.
DJANGO_SECRET_KEY=dev-secret-change-me

# Hosts allowed to serve the site.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Defaults to a local SQLite file when unset.
# DATABASE_URL=postgres://user:password@localhost:5432/showcuts

# Optional overrides
# DJANGO_TIME_ZONE=UTC
# DJANGO_LIVE_RELOADING=True
